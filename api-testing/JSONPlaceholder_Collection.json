    {
      "name": "Users",
      "item": [
        {
          "name": "GET All Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test 1: Status code is 200",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Test 2: Response is JSON",
                  "pm.test('Response is JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "// Test 3: Response is an array",
                  "pm.test('Response body is an array', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});",
                  "",
                  "// Test 4: Array is not empty",
                  "pm.test('Array is not empty', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.length).to.be.above(0);",
                  "});",
                  "",
                  "// Test 5: First user has required fields",
                  "pm.test('First user has id, name, email', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData[0]).to.have.property('id');",
                  "    pm.expect(jsonData[0]).to.have.property('name');",
                  "    pm.expect(jsonData[0]).to.have.property('email');",
                  "});",
                  "",
                  "// Test 6: Response time under 2000ms",
                  "pm.test('Response time is less than 2000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            },
            "description": "Retrieves a list of all users.\n\n**Expected:**\n- Status: 200 OK\n- Body: JSON array of user objects\n- Each user has: id, name, username, email, phone, website, address, company"

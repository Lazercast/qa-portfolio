    "name": "ReqRes API - QA Portfolio",
    "description": "API test collection for ReqRes (https://reqres.in/)\nCreated for Junior QA Portfolio.\n\nCoverage:\n- GET users (list & single)\n- POST create user\n- PUT update user\n- DELETE user\n- POST login (success & fail)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://reqres.in/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "GET List Users (Page 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has data array', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Pagination fields exist', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('page');",
                  "    pm.expect(jsonData).to.have.property('per_page');",
                  "    pm.expect(jsonData).to.have.property('total');",
                  "    pm.expect(jsonData).to.have.property('total_pages');",
                  "});",
                  "",
                  "pm.test('Each user has id, email, first_name, last_name, avatar', function () {",
                  "    const jsonData = pm.response.json();",
                  "    const user = jsonData.data[0];",
                  "    pm.expect(user).to.have.property('id');",
                  "    pm.expect(user).to.have.property('email');",
                  "    pm.expect(user).to.have.property('first_name');",
                  "    pm.expect(user).to.have.property('last_name');",
                  "    pm.expect(user).to.have.property('avatar');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users?page=1",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [{ "key": "page", "value": "1" }]
            },
            "description": "Retrieves a paginated list of users.\n\n**Expected:**\n- Status: 200 OK\n- Body: Object with `page`, `per_page`, `total`, `total_pages`, `data` array"
          },
          "response": []
        },
        {
          "name": "GET Single User (Valid ID = 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has data object', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.data).to.be.an('object');",
                  "});",
                  "",
                  "pm.test('User ID is 2', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.id).to.equal(2);",
                  "});",
                  "",
                  "pm.test('Email contains @ symbol', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.email).to.include('@');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/2",
              "host": ["{{base_url}}"],
              "path": ["users", "2"]
            },
            "description": "Retrieves a single user with ID = 2.\n\n**Expected:**\n- Status: 200 OK\n- Body: Object with `data` and `support` fields"
          },
          "response": []
